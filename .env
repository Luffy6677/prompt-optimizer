# Environment Configuration for prompt-optimizer

# Server Configuration
PORT=3001

# Deepseek Configuration (for AI-powered prompt optimization)
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Supabase Configuration (for user authentication and favorites)
# IMPORTANT: Replace these with your actual Supabase project credentials
# Follow the setup guide in SUPABASE_SETUP.md to get these values
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Development Environment
NODE_ENV=development

# ============================================
# SETUP INSTRUCTIONS:
# ============================================
# 1. Create a Supabase project at https://supabase.com/
# 2. Go to Settings > API in your Supabase dashboard
# 3. Copy your Project URL and replace "https://your-project-id.supabase.co"
# 4. Copy your anon/public key and replace "your-supabase-anon-key-here"
# 5. Get a Deepseek API key from https://platform.deepseek.com/api_keys
# 6. Replace "your_deepseek_api_key_here" with your actual API key
# 
# For detailed setup instructions, see SUPABASE_SETUP.md